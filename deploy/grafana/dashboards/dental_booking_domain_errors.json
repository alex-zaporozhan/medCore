{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Domain-layer validation/business errors (patients, …).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "mode": "markdown",
        "content": "**domain_errors_total** — разрез `domain`, `code`, `clinic_bucket`. Дополняет booking_errors_total (W7)."
      },
      "title": "Notes",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 3 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (domain, code) (rate(domain_errors_total[5m]))",
          "legendFormat": "{{domain}} / {{code}}",
          "refId": "A"
        }
      ],
      "title": "Domain error rate by domain and code",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["dental_booking", "domain_errors", "qa_arch"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Dental Booking — Domain errors",
  "uid": "dental-booking-domain-errors",
  "version": 1
}
