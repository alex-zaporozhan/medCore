# --- ЛОКАЛХОСТ (этот проект) ---
# Для запуска API на своей машине (uvicorn с хоста): оставь localhost в DATABASE_URL и REDIS_URL.
# Сначала подними только БД и Redis (имена сервисов в compose — db и redis):
#   docker compose up -d db redis
# Затем: poetry run uvicorn src.main:app --reload
# Документация API: http://localhost:8000/docs
#
# Если запускаешь всё в Docker (docker-compose up api), compose сам подставит хосты postgres/redis.
#
# Docker Compose — образы backend/frontend/migrations/celery (см. docker-compose.yml).
# Для staging/prod используйте только immutable digests:
# BACKEND_IMAGE=moircreator/dental-booking-backend@sha256:<immutable_digest>
# FRONTEND_IMAGE=moircreator/dental-booking-frontend@sha256:<immutable_digest>
# Только локальная сборка без совпадения с Hub:
# BACKEND_IMAGE=dental-booking-backend:local
# FRONTEND_IMAGE=dental-booking-frontend:local

# Database (используются в docker-compose для postgres и для DATABASE_URL в контейнерах)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dental_booking

# Database URL: для локального запуска с хоста — порт как в docker-compose.yml (сейчас 5442→5432 в контейнере)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5442/dental_booking
# Optional read replica for admin report GETs (Wave 5 / ADR-005). Unset = primary only.
# DATABASE_REPLICA_URL=postgresql+asyncpg://postgres:postgres@localhost:5442/dental_booking
# Reporting query timeout in ms (0 = disabled). Applied to reporting sessions.
DB_REPORTING_STATEMENT_TIMEOUT_MS=120000
# GET /health/replica: flag lag_warning when lag_seconds exceeds this (standby only).
DB_REPLICA_LAG_WARN_SECONDS=60
# Тесты: та же строка, но БД dental_booking_test (создайте БД и накатите миграции — см. docs/development/TEST_DATABASE.md).
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5442/dental_booking_test
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis (в docker-compose redis на порту 6380)
REDIS_URL=redis://localhost:6380/0
REDIS_URL_TEST=redis://localhost:6380/0
REDIS_POOL_SIZE=10
# Cache JSON for GET .../reports/dashboard and .../owner-dashboard (invalidated after vitrine refresh).
ERP_DASHBOARD_CACHE_ENABLED=true
ERP_DASHBOARD_CACHE_TTL_SECONDS=60

# Application
APP_NAME=dental-booking
APP_ENV=development
# Редакция API: enterprise (по умолчанию) | box | basic — должна соответствовать VITE_EDITION на фронте.
# В коробке блокируются Enterprise-only маршруты (retention ROI, CRM /admin/crm).
# EDITION=enterprise
# Immutable audit rows for CRM PATCH /leads/.../estimated-value when true (CRM_MONEY H6).
COMPLIANCE_CRM_AUDIT_ENABLED=false
# W7 BE5: burst booking/payment errors → Task (needs Redis); off by default.
BOOKING_ERROR_ATTENTION_ENABLED=false
BOOKING_ERROR_ATTENTION_WINDOW_SECONDS=300
BOOKING_ERROR_ATTENTION_THRESHOLD=12
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# YooKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_TEST_MODE=true
# URL, куда ЮKassa вернёт пользователя после оплаты (например PWA или страница успеха)
YOOKASSA_RETURN_URL=https://localhost:5173/app/booking/success

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# SMS (SMSC.ru)
SMSC_LOGIN=your-smsc-login
SMSC_PASSWORD=your-smsc-password
SMSC_SENDER=your-sender-name

# Email (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@dental-booking.local

# Celery (локальный запуск против Redis на 6380; в Docker берётся redis:6379)
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
# Маскирование телефонов в JSON-логах (SME §2.4)
LOG_MASK_PII=true

# AI provider (chat assistant)
# Пример для DeepSeek (OpenAI-совместимый API):
#   AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1
#   AI_PROVIDER_MODEL=deepseek-chat
#   AI_PROVIDER_API_KEY=sk-...
# Если BASE_URL пустой — backend будет отдавать упрощённые локальные подсказки без реального AI.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=deepseek-chat
AI_PROVIDER_API_KEY=REDACTED
# Omnichannel AI Telegram notifications:
# - suggestions: лучше включать только в production (в локальной разработке шумит).
OMNI_AI_NOTIFY_SUGGESTION_TELEGRAM_ENABLED=false
# - operator escalation: обычно полезно оставить включённым.
OMNI_AI_NOTIFY_OPERATOR_TELEGRAM_ENABLED=true
OMNI_AI_NOTIFY_SUGGESTION_DEDUP_SECONDS=300
OMNI_AI_NOTIFY_OPERATOR_DEDUP_SECONDS=120
AI_TIMEOUT_SECONDS=10

# Booking AI tools (Omni): max calendar span and max slots returned per get_available_slots (J3).
# BOOKING_AI_TOOLS_MAX_RANGE_DAYS=14
# BOOKING_AI_TOOLS_MAX_SLOTS=80

# ERP отчёты (Engine L2): чтение из витрин (выручка, payroll, materials, ROI/attribution).
# false — всегда сырой SQL (fallback), удобно для отладки / сравнения.
# ERP_REPORTS_READ_FROM_AGGREGATE=true
# Опционально: переопределение по виду витрины (если не задано — действует мастер-флаг выше).
# ERP_VISIT_REVENUE_READ_FROM_AGGREGATE=
# ERP_PAYROLL_READ_FROM_AGGREGATE=
# ERP_MATERIALS_READ_FROM_AGGREGATE=
# ERP_ATTRIBUTION_READ_FROM_AGGREGATE=
# ERP_AGGREGATE_REFRESH_LOOKBACK_DAYS=8
# ERP_AGGREGATE_STALE_MAX_SECONDS=7200
# Событие завершения визита: фоновый пересчёт витрин за день визита (Celery + Redis debounce).
# ERP_AGGREGATE_EVENT_REFRESH_ENABLED=false
# ERP_AGGREGATE_EVENT_DEBOUNCE_SECONDS=120
# Ежедневная выборочная сверка sum(raw) vs sum(vitrine) для visit_revenue (одна клиника × вчера UTC); Celery worker + beat.
# ERP_AGGREGATE_PARITY_SAMPLE_ENABLED=false
# Ручной пересчёт: POST /admin/clinics/{id}/reports/erp-aggregates/refresh  body: { "kind": "all"|... }
